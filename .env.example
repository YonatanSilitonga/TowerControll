# URL base API backend Laravel (tanpa trailing slash)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Mode mock: true = preview frontend pakai data contoh TANPA backend.
# Ubah ke false (atau hapus) saat mau connect ke backend beneran.
NEXT_PUBLIC_USE_MOCK=true

# Interval polling summary control tower (ms)
NEXT_PUBLIC_POLL_INTERVAL=30000
